rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(listId) {
      return signedIn() && get(/databases/$(database)/documents/lists/$(listId)).data.creatorId == request.auth.uid;
    }

    function ownerAfterCreate(listId) {
      return signedIn() && getAfter(/databases/$(database)/documents/lists/$(listId)).data.creatorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      allow read: if resource.data.published == true;
      allow create: if signedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.published == true;
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if get(/databases/$(database)/documents/lists/$(listId)).data.published == true;
        allow create: if ownerAfterCreate(listId);
        allow update, delete: if false;
      }

      // Votes and per-session counters are written only by the authenticated server route.
      match /votes/{voteId} {
        allow read, write: if false;
      }

      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }
  }
}
